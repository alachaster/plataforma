    "@aws-sdk/s3-request-presigner": "^3.876.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "@types/pg": "^8.15.5",
    "@types/leaflet": "^1.9.20",
    "@netlify/plugin-nextjs": "^5.9.0"
